# Produzione 16bit (letto da `vite build`, non dal dev server).
# Un solo preset neutro da 600x600: VITE_QR_CODE_PRESETS sostituisce
# interamente la galleria dei preset built-in.
VITE_QR_CODE_PRESETS='[{"name":"16bit 600","data":"","image":"","width":600,"height":600,"margin":0,"type":"svg","backgroundOptions":{"color":"transparent"},"dotsOptions":{"color":"#000000","type":"square"},"cornersSquareOptions":{"color":"#000000","type":"square"},"cornersDotOptions":{"color":"#000000","type":"square"},"imageOptions":{"margin":0},"qrOptions":{"errorCorrectionLevel":"Q"},"style":{"borderRadius":"0px","background":"#ffffff"}}]'
VITE_DEFAULT_PRESET=16bit 600
